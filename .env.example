# Server
SERVER_PORT=3001

# Database
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_DIALECT=postgres
DB_PORT=5432

# JWT
JWT_SECRET_KEY=your_secret_key_here

# Environment
