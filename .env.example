# Server
SERVER_PORT=3001

# Database
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_DIALECT=postgres
DB_PORT=5432

# JWT (мінімум 32 символи; згенеруйте випадковий рядок)
JWT_SECRET_KEY=your_random_secret_key_at_least_32_chars

# Environment
NODE_ENV=development

# Локально: автозміна схеми БД (у production залиште false або не встановлюйте)
DB_SYNC_ALTER=true

# Admin: id користувача, якому при старті виставляється is_admin=true
ADMIN_USER_ID=1